[Unit]
Description=Stranger video chat (Rust/axum)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/stranger
EnvironmentFile=/opt/stranger/.env
ExecStart=/opt/stranger/bin/stranger-server
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/stranger/data

[Install]
WantedBy=multi-user.target
