{
  "name": "stranger-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"cd rust && STATIC_DIR=../dist cargo watch -x run\"",
    "dev:once": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"cd rust && STATIC_DIR=../dist cargo run\"",
    "free-ports": "bash scripts/free-ports.sh",
    "dev:fresh": "bash scripts/free-ports.sh && concurrently -k -n web,api -c cyan,magenta \"vite\" \"cd rust && STATIC_DIR=../dist cargo watch -x run\"",
    "build": "tsc -b && vite build",
    "build:server": "cd rust && cargo build --release",
    "build:all": "npm run build && npm run build:server",
    "start": "./rust/target/release/stranger-server",
    "start:prod": "NODE_ENV=production APP_VERSION=$npm_package_version ./rust/target/release/stranger-server",
    "check": "tsc -b --pretty false",
    "check:generated": "bash scripts/check-generated.sh",
    "rust:build": "cd rust && cargo build",
    "rust:test": "cd rust && cargo test",
    "migrate:auth": "cd rust && cargo run --bin migrate-auth",
    "migrate:auth-users": "cd rust && cargo run --bin migrate-auth-users",
    "test": "npm run build:server && vitest run",
    "test:integration": "npm run build:server && vitest run tests/api.integration.test.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm run check:generated && npm run rust:test && npm run build:all && npm run test && CI=1 npm run test:e2e",
    "test:watch": "vitest",
    "loadtest": "node scripts/load-test.mjs",
    "smoke": "bash scripts/smoke.sh",
    "backup": "bash scripts/backup-db.sh",
    "docker:up": "docker compose up --build -d",
    "docker:turn": "docker compose --profile turn up --build -d"
  },
  "dependencies": {
    "concurrently": "^10.0.3",
    "preact": "^10.26.0",
    "preact-router": "^4.1.2",
    "vite": "^8.2.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@preact/preset-vite": "^2.10.0",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@babel/core": "^7.26.10",
    "@babel/traverse": "^7.26.10",
    "@babel/types": "^7.26.10",
    "@babel/generator": "^7.26.10",
    "@babel/parser": "^7.26.10",
    "@babel/template": "^7.26.10",
    "@babel/helper-module-transforms": "^7.26.0",
    "@babel/helper-plugin-utils": "^7.26.0",
    "@babel/plugin-transform-react-jsx": "^7.25.9",
    "@babel/plugin-transform-react-jsx-development": "^7.25.9"
  }
}
