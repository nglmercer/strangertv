TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token
PORT=8787
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
# Google sign-in. Leave both empty to keep the provider switched off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to 1 when a deploy pipeline or a one-off job runs migrate-auth instead
# of the container entrypoint (required for multi-replica rollouts).
SKIP_AUTH_MIGRATION=0
# Only for split dev deployments: the API origin Google redirects back to.
# Defaults to APP_URL, which is correct when the server also serves the SPA.
OAUTH_REDIRECT_BASE_URL=
TURN_SECRET=
TURN_URLS=
# Dev-only placeholder: production startup rejects this value. Generate a
# random key of at least 16 chars for any production deploy
# (e.g. `openssl rand -hex 16`).
ADMIN_KEY=change-me-in-production
EMAIL_WEBHOOK_URL=
MAIL_FROM=noreply@stranger.local
SMTP_URL=
LOG_LEVEL=info
METRICS_PUBLIC=0
STATIC_DIR=
NODE_ENV=development
# Off by default: anonymous users have no server-verifiable age, and video
# matchmaking is 18+. Turn on only for explicit legacy/dev use.
FEATURE_ANONYMOUS_MATCH=false
FEATURE_GUEST_REPORTS=true
FEATURE_QUALITY_TELEMETRY=true
FEATURE_REQUIRE_EMAIL_VERIFIED=false
SHUTDOWN_DRAIN_MS=8000
REMATCH_COOLDOWN_MS=600000
ALERT_WEBHOOK_URL=
ALERT_REPORTS_THRESHOLD=10
# Proxy IPs/CIDRs whose x-forwarded-for/x-real-ip headers are honored.
# Empty (default) trusts none: every client is its socket peer address.
# Example behind a load balancer: TRUSTED_PROXIES=10.0.0.0/8,192.168.1.10
TRUSTED_PROXIES=

